# Rust
/target/
**/*.rs.bk

# Environment and secrets — never commit a key
.env
.env.local
*.pem
*.key

# Noir / Barretenberg build artefacts
circuits/**/target/
circuits/**/proofs/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# contracts/lib/ is NOT ignored: forge-std is a git submodule, and ignoring it
# would leave a fresh clone unable to build the contracts.

# Worker scratch space
scratch/

# WSL artefacts from files copied off Windows
*:Zone.Identifier

# Editors and OS
.DS_Store
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json
.claude/*.tmp.*
